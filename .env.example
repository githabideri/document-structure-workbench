# Document Structure Workbench - Environment Configuration
# Copy to .env and fill in values

# Django security
DSW_DJANGO_SECRET_KEY=change-me-to-random-string
DSW_DEBUG=false
DSW_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
# DSW_DATABASE_URL=postgres://user:password@localhost:5432/dsw

# API authentication
DSW_API_KEY=change-me-to-random-string

# Email (optional, for notifications)
# DSW_EMAIL_HOST=
# DSW_EMAIL_PORT=587
# DSW_EMAIL_USER=
# DSW_EMAIL_PASSWORD=

# Gunicorn
DSW_GUNICORN_WORKERS=2
DSW_GUNICORN_BIND=0.0.0.0:8000

# Processing
# DSW_DOCLING_API_URL=http://localhost:8001
# DSW_DOCLING_API_KEY=
DSW_DOCLING_OCR_ENGINE=rapidocr
DSW_DOCLING_OCR_BACKEND=torch
DSW_DOCLING_OCR_LANG=de,en
DSW_DOCLING_OCR_ENABLED=false
DSW_DOCLING_IMAGES_SCALE=2.0
DSW_PROCESSING_STALE_AFTER_SECONDS=90
DSW_PROCESSING_LEASE_SECONDS=90
DSW_PROCESSING_MAX_STATUS_ERRORS=5

# Optional OpenAI-compatible visual OCR candidate provider.
# In the homelab deployment this should point from DSW LXC 386 to the
# OCR/VLM service exposed by the GPU LXC 348, for example:
# DSW_OCR_BASE_URL=http://192.168.0.48:8000/v1
# 127.0.0.1 is only correct when the OCR server runs inside the DSW LXC.
# DSW_OCR_API_KEY=
# DSW_OCR_MODEL=PaddleOCR-VL-0.9B
# Default visual reruns use the configured chat Qwen vision model. The UI/API
# also allow selecting PaddleOCR-VL per request.
DSW_OCR_PROVIDER=qwen
DSW_OCR_TIMEOUT=300
DSW_INGESTION_OCR_ENABLED=true
DSW_INGESTION_OCR_REQUIRED=true
DSW_INGESTION_OCR_PROVIDER=paddleocr-vl
# Defaults to DSW_OCR_MODEL when omitted.
DSW_INGESTION_OCR_MODEL=PaddleOCR-VL-0.9B
