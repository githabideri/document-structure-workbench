# Document Structure Workbench - Environment Configuration
# Copy to .env and fill in values

# Django security
DSW_DJANGO_SECRET_KEY=change-me-to-random-string
DSW_DEBUG=false
DSW_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
# DSW_DATABASE_URL=postgres://user:password@localhost:5432/dsw

# API authentication
DSW_API_KEY=change-me-to-random-string

# Email (optional, for notifications)
# DSW_EMAIL_HOST=
# DSW_EMAIL_PORT=587
# DSW_EMAIL_USER=
# DSW_EMAIL_PASSWORD=

# Gunicorn
DSW_GUNICORN_WORKERS=2
DSW_GUNICORN_BIND=0.0.0.0:8000

# Processing
# DSW_DOCLING_API_URL=http://localhost:8001
# DSW_DOCLING_API_KEY=
