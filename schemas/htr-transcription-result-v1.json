{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://document-structure-workbench.example/schemas/htr-transcription-result-v1.json",
  "title": "HTR transcription result (v1)",
  "description": "Response shape for the DSW HTR service transcription endpoints (POST /v1/transcriptions -> 202; GET /v1/transcriptions/{id}). All coordinates are NORMALIZED TO THE SUBMITTED CROP (0.0-1.0), never page pixels. The HTR service normalizes HTRflow output into this shape so DSW never needs to understand pixel-coordinate details. Shared by the HTR service, DSW backend, and DSW frontend so all three agree on field names.",
  "type": "object",
  "required": ["id", "status", "pipeline"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "description": "Opaque server job id."},
    "status": {"type": "string", "enum": ["pending", "running", "succeeded", "failed"]},
    "scope": {"type": "string", "enum": ["region", "page"], "description": "What the submitted image represented."},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "label": {"type": "string", "description": "Opaque DSW reference passed at submission (e.g. document-183-page-4-region-912)."},
    "self": {"type": "string", "description": "Relative URL of this resource, e.g. /v1/transcriptions/{id}."},
    "pipeline": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"}
      },
      "additionalProperties": false
    },
    "page": {"$ref": "#/definitions/pageSize"},
    "regions": {"type": "array", "items": {"$ref": "#/definitions/region"}},
    "text": {"type": "string", "description": "All line text joined in reading order with newlines."},
    "diagnostics": {"$ref": "#/definitions/diagnostics"},
    "execution": {"$ref": "#/definitions/execution"},
    "error": {"$ref": "#/definitions/error"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"required": ["scope", "page", "regions", "text", "diagnostics", "execution", "completed_at"]}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"required": ["error", "completed_at"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["pending", "running"]}}},
      "then": {"required": ["created_at"]}
    }
  ],
  "definitions": {
    "pageSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "description": "Normalized rectangle relative to the submitted crop.",
      "required": ["xmin", "ymin", "xmax", "ymax"],
      "properties": {
        "xmin": {"type": "number", "minimum": 0, "maximum": 1},
        "ymin": {"type": "number", "minimum": 0, "maximum": 1},
        "xmax": {"type": "number", "minimum": 0, "maximum": 1},
        "ymax": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "required": ["label", "bbox", "text", "candidates", "scores", "confidence", "order"],
      "properties": {
        "label": {"type": "string"},
        "bbox": {"$ref": "#/definitions/bbox"},
        "text": {"type": "string", "description": "Top candidate text."},
        "candidates": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "scores": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Recognition confidence (mean of scores, or null if unknown)."},
        "segmentation_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "order": {"type": "integer", "minimum": 1, "description": "Reading order, 1-based."}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["label", "bbox", "lines"],
      "properties": {
        "label": {"type": "string"},
        "bbox": {"$ref": "#/definitions/bbox"},
        "lines": {"type": "array", "items": {"$ref": "#/definitions/line"}}
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": ["n_regions", "n_lines", "mean_line_confidence"],
      "properties": {
        "n_regions": {"type": "integer", "minimum": 0},
        "n_lines": {"type": "integer", "minimum": 0},
        "mean_line_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["device", "duration_ms"],
      "properties": {
        "device": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
