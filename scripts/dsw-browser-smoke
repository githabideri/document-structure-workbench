#!/usr/bin/env bash
set -uo pipefail

# Generic browser acceptance scenario. Credentials are read only from the
# environment and never written to the result file.
base_url="${DSW_BROWSER_BASE_URL:-http://127.0.0.1:8000}"
username="${DSW_BROWSER_USERNAME:-}"
password="${DSW_BROWSER_PASSWORD:-}"
question="${DSW_BROWSER_QUESTION:-What does the selected document discuss?}"
output_dir="${DSW_BROWSER_OUTPUT_DIR:-/tmp/dsw-browser-smoke-$(date +%Y%m%d-%H%M%S)}"
project_id="${DSW_BROWSER_PROJECT_ID:-}"
source_ids="${DSW_BROWSER_SOURCE_IDS:-}"
scope_mode="${DSW_BROWSER_SCOPE_MODE:-all}"
allow_remote="${DSW_BROWSER_ALLOW_REMOTE:-0}"
browser="$(dirname "$0")/agent-browser-dsw"

usage() {
  cat <<'EOF'
Usage: scripts/dsw-browser-smoke [options]

Runs the generic login -> chat -> answer -> citation -> return acceptance flow.
Documents are discovered dynamically by default. For deployed servers, pin a
dedicated fixture and explicitly allow remote execution.

Options:
  -h, --help              Show this help.
  --base-url URL          Application URL (or DSW_BROWSER_BASE_URL).
  --username NAME         Browser test username (or DSW_BROWSER_USERNAME).
  --password PASSWORD     Convenience only; prefer DSW_BROWSER_PASSWORD.
  --project-id ID         Expected fixture project ID.
  --source-ids IDS        Comma-separated fixture source IDs.
  --scope-mode MODE       project or all (default: all).
  --question TEXT         Question to ask.
  --output-dir PATH       Artifact directory.
  --allow-remote          Permit non-local BASE_URL (required for staging).

Environment:
  DSW_BROWSER_BASE_URL, DSW_BROWSER_USERNAME, DSW_BROWSER_PASSWORD,
  DSW_BROWSER_PROJECT_ID, DSW_BROWSER_SOURCE_IDS, DSW_BROWSER_ALLOW_REMOTE,
  DSW_BROWSER_SCOPE_MODE, DSW_BROWSER_OUTPUT_DIR, DSW_BROWSER_WAIT_ATTEMPTS.
EOF
}
while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0;;
    --base-url) base_url="${2:?missing URL}"; shift 2;;
    --username) username="${2:?missing username}"; shift 2;;
    --password) password="${2:?missing password}"; shift 2;;
    --project-id) project_id="${2:?missing project ID}"; shift 2;;
    --source-ids) source_ids="${2:?missing source IDs}"; shift 2;;
    --scope-mode) scope_mode="${2:?missing scope mode}"; shift 2;;
    --question) question="${2:?missing question}"; shift 2;;
    --output-dir) output_dir="${2:?missing output directory}"; shift 2;;
    --allow-remote) allow_remote=1; shift;;
    *) echo "browser-smoke: unknown option $1" >&2; usage >&2; exit 2;;
  esac
done

case "$base_url" in
  http://127.0.0.1:*|http://localhost:*|https://127.0.0.1:*|https://localhost:*) ;;
  *) [[ "$allow_remote" == 1 ]] || { echo "browser-smoke: remote URL requires --allow-remote" >&2; exit 2; };;
esac
[[ "$scope_mode" == all || "$scope_mode" == project ]] || { echo "browser-smoke: --scope-mode must be all or project" >&2; exit 2; }
if [[ "$allow_remote" == 1 && -z "$source_ids" ]]; then
  echo "browser-smoke: remote execution requires --source-ids for fixture safety" >&2
  exit 2
fi
if [[ -n "$project_id" && ! "$project_id" =~ ^[0-9]+$ ]]; then
  echo "browser-smoke: --project-id must be numeric" >&2
  exit 2
fi
if [[ -n "$source_ids" && ! "$source_ids" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
  echo "browser-smoke: --source-ids must be comma-separated numeric IDs" >&2
  exit 2
fi
mkdir -p "$output_dir"
steps_file="$output_dir/steps.ndjson"
: > "$steps_file"

record() {
  local name="$1" status="$2" detail="${3:-}"
  python3 -c 'import json,sys; print(json.dumps({"scenario":sys.argv[1],"status":sys.argv[2],"detail":sys.argv[3]}))' "$name" "$status" "$detail" >> "$steps_file"
}
step() {
  local name="$1"; shift
  if "$@" >"$output_dir/$name.log" 2>&1; then record "$name" pass; return 0; fi
  record "$name" fail "see $output_dir/$name.log"; return 1
}
count() { "$browser" get count "$1" 2>/dev/null | tail -1 | tr -dc '0-9'; }
snapshot() {
  local name="$1"
  if "$browser" snapshot -i -c >"$output_dir/$name.snapshot" 2>&1; then
    record "snapshot-$name" pass "$output_dir/$name.snapshot"
  else
    record "snapshot-$name" fail "$output_dir/$name.snapshot"
  fi
}
write_result() {
  local release url
  release="$(curl -fsS "$base_url/api/v1/health/" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("release") or "")' 2>/dev/null || true)"
  url="$($browser get url 2>/dev/null | tail -1 || true)"
  python3 -c 'import json,sys; steps=[json.loads(line) for line in open(sys.argv[1]) if line.strip()]; out=sys.argv[8]; result={"status":"pass" if sys.argv[7]=="0" and steps and all(x["status"]=="pass" for x in steps) else "fail","url":sys.argv[2],"release":sys.argv[3],"project_id":sys.argv[4],"scope_mode":sys.argv[5],"source_ids":[x for x in sys.argv[6].split(",") if x],"screenshots":[out+"/conversation.png",out+"/cited-document.png",out+"/returned-chat.png"],"artifacts":{"accessibility_snapshots":out,"console":out+"/console.log","page_errors":out+"/errors.log","network_har":out+"/network.har","ui_diagnostics":out+"/ui-diagnostics.json"},"scenarios":steps}; open(out+"/result.json","w").write(json.dumps(result,indent=2)+"\n"); print(json.dumps(result))' "$steps_file" "$url" "$release" "$project_id" "$scope_mode" "$source_ids" "$status" "$output_dir"
}
fail() { echo "browser-smoke: $*" >&2; exit 1; }
finish() {
  local status=$?
  "$browser" console >"$output_dir/console.log" 2>&1 || true
  "$browser" errors >"$output_dir/errors.log" 2>&1 || true
  "$browser" network har stop "$output_dir/network.har" >"$output_dir/network-har.log" 2>&1 || true
  "$browser" eval 'JSON.stringify(window.__DSW_UI_DIAGNOSTICS__ || {})' >"$output_dir/ui-diagnostics.raw" 2>&1 || true
  python3 -c 'import json,sys; raw=open(sys.argv[1]).read().strip(); value=json.loads(raw) if raw else {}; value=json.loads(value) if isinstance(value,str) else value; open(sys.argv[2],"w").write(json.dumps(value,indent=2)+"\n")' "$output_dir/ui-diagnostics.raw" "$output_dir/ui-diagnostics.json" 2>/dev/null || echo '{"schema_version":1,"error":"diagnostics unavailable"}' >"$output_dir/ui-diagnostics.json"
  write_result || true
  "$browser" close --all >/dev/null 2>&1 || true
  return "$status"
}

trap finish EXIT
[[ -n "$username" && -n "$password" ]] || fail "set DSW_BROWSER_USERNAME and DSW_BROWSER_PASSWORD"
"$browser" close --all >/dev/null 2>&1 || true
"$browser" network har start >/dev/null 2>&1 || true

step login "$browser" open "$base_url/login/" || fail "login navigation failed"
step login_fill "$browser" find label Username fill "$username" || fail "username field not found"
step login_password "$browser" find label Password fill "$password" || fail "password field not found"
step login_submit "$browser" find role button click --name Login || fail "login submit failed"
if "$browser" wait --text 'Home' >"$output_dir/login_wait.log" 2>&1; then
  record login_wait pass
elif "$browser" wait --text 'Fragen' >"$output_dir/login_wait_localized.log" 2>&1; then
  record login_wait pass "localized authenticated navigation"
else
  record login_wait fail "see $output_dir/login_wait*.log"
  fail "login did not reach the authenticated workspace"
fi
record login pass
snapshot login

step create_thread_open "$browser" open "$base_url/chat/" || fail "chat workspace did not open"
snapshot chat-start
scope_js="const scope=document.querySelector('#scope_mode'); if(scope){scope.value='${scope_mode}'; scope.dispatchEvent(new Event('change'));} const project=document.querySelector('#project_id'); if(project && '${scope_mode}'==='project' && '${project_id}') project.value='${project_id}'; JSON.stringify({scope:scope&&scope.value,project:project&&project.value});"
step select-scope "$browser" eval -b "$(printf '%s' "$scope_js" | base64 -w0)" || fail "could not select chat scope"
record verify-scope pass "mode=$scope_mode"
source_count="$(count 'input[name=source]')"
[[ "${source_count:-0}" -gt 0 ]] || fail "no accessible generic documents were discovered"
record select-documents pass "discovered $source_count documents"
if [[ -n "$source_ids" ]]; then
  encoded_ids="$(python3 -c 'import base64,sys; print(base64.b64encode(sys.argv[1].encode()).decode())' "$source_ids")"
  js="const ids='${source_ids}'.split(',').map(x=>x.trim()); const matches=[...document.querySelectorAll('input[name=source]')].filter(x=>ids.includes(x.value)); matches.forEach(x=>{if(!x.checked)x.click()}); JSON.stringify({matched:matches.length,selected:matches.filter(x=>x.checked).map(x=>x.value),projects:[...new Set(matches.map(x=>x.dataset.projectId))]});"
  step select_fixture "$browser" eval -b "$(printf '%s' "$js" | base64 -w0)" || fail "could not select pinned fixture documents"
  selected_count="$(count 'input[name=source]:checked')"
  expected_count="$(awk -F, '{print NF}' <<<"$source_ids")"
  [[ "$selected_count" == "$expected_count" ]] || fail "pinned source IDs were not all present in the UI"
  if [[ -n "$project_id" ]]; then
    project_selected_count="$(count "input[name=source]:checked[data-project-id='$project_id']")"
    [[ "$project_selected_count" == "$expected_count" ]] || fail "pinned sources are not all in the expected project"
  fi
else
  step select_first "$browser" find first 'input[name=source]' check || fail "could not select a document"
  if [[ "${source_count:-0}" -gt 1 ]]; then
    step select_second "$browser" find nth 2 'input[name=source]' check || fail "could not select second document"
  fi
fi
if "$browser" find label Question fill "$question" >"$output_dir/ask_question.log" 2>&1; then
  record ask_question pass
elif "$browser" find label Frage fill "$question" >"$output_dir/ask_question_localized.log" 2>&1; then
  record ask_question pass "localized question label"
else
  record ask_question fail "see $output_dir/ask_question*.log"; fail "question field not found"
fi
if "$browser" find role button click --name 'Start conversation' >"$output_dir/ask_submit.log" 2>&1; then
  record ask_submit pass
elif "$browser" find role button click --name 'Gespräch starten' >"$output_dir/ask_submit_localized.log" 2>&1; then
  record ask_submit pass "localized submit label"
else
  record ask_submit fail "see $output_dir/ask_submit*.log"; fail "conversation submit failed"
fi
if "$browser" wait --text 'Documents' >"$output_dir/create_thread_wait.log" 2>&1; then
  record create_thread_wait pass
elif "$browser" wait --text 'Dokumente' >"$output_dir/create_thread_wait_localized.log" 2>&1; then
  record create_thread_wait pass "localized evidence panel"
else
  record create_thread_wait fail "see $output_dir/create_thread_wait*.log"; fail "conversation did not open"
fi
record create-thread pass
snapshot conversation-start

for attempt in $(seq 1 "${DSW_BROWSER_WAIT_ATTEMPTS:-60}"); do
  assistants="$(count '.chat-message-assistant')"
  citations="$(count '.chat-citation')"
  if [[ "${assistants:-0}" -gt 0 && "${citations:-0}" -gt 0 ]]; then break; fi
  "$browser" wait 1000 >/dev/null 2>&1 || true
done
[[ "${assistants:-0}" -gt 0 ]] || fail "no readable assistant answer appeared"
[[ "${citations:-0}" -gt 0 ]] || fail "no citation appeared in assistant answer"
record wait-for-run pass
record verify-answer pass "assistant=$assistants citations=$citations"
snapshot conversation-answer
step conversation-screenshot "$browser" screenshot "$output_dir/conversation.png" || fail "conversation screenshot failed"

evidence_count="$(count '.chat-citation')"
[[ "${evidence_count:-0}" -gt 0 ]] || fail "assistant citations are empty"
record evidence-panel pass "items=$evidence_count"
step open-citation "$browser" click '.chat-citation' || fail "citation could not be opened"
step citation-wait "$browser" wait '[data-ui-id="evidence-heading"]' || fail "evidence reader did not open"
citation_url="$($browser get url 2>/dev/null | tail -1 || true)"
[[ "$citation_url" == *"evidence="* ]] || fail "citation did not create evidence URL state"
step evidence-focus "$browser" eval 'JSON.stringify({active:document.activeElement?.dataset?.uiId||document.activeElement?.id||null,heading:document.querySelector("[data-ui-id=\"evidence-heading\"]")?.textContent||""})' || fail "evidence focus state unavailable"
snapshot cited-document
step cited-document-screenshot "$browser" screenshot "$output_dir/cited-document.png" || fail "cited document screenshot failed"
record open-citation pass

if [[ "${DSW_BROWSER_EXPECT_MAINTAINER:-0}" == 1 ]]; then
  step inspector-open "$browser" click '.run-inspector-open' || fail "run inspector could not be opened"
  step inspector-wait "$browser" wait '[data-ui-id="run-inspector"]:not([hidden])' || fail "run inspector did not open"
  step inspector-close-with-evidence "$browser" eval "document.querySelector('.inspector-close')?.click(); 'closed'" || fail "run inspector could not be closed"
  step inspector-close-settle "$browser" wait 100 || fail "run inspector close did not settle"
  step inspector-restores-evidence "$browser" eval "(()=>{const p=document.querySelector('.evidence-reader-panel'); const s=new URL(location.href).searchParams; const active=document.activeElement?.dataset?.uiId||null; const state={panelHidden:p?.hidden||false,run:s.get('run'),evidence:s.get('evidence'),active}; if(state.panelHidden||state.evidence!=='S1'||active!=='run-action-'+state.run) throw new Error('closing inspector did not restore evidence and focus: '+JSON.stringify(state)); return JSON.stringify(state)})()" || fail "inspector close did not restore selected evidence"
  step close-evidence-for-inspector "$browser" eval "document.querySelector('.evidence-close')?.click(); 'closed'" || fail "evidence could not be closed before context test"
  step close-evidence-for-inspector-settle "$browser" wait 100 || fail "evidence close did not settle before context test"
  step close-evidence-for-inspector-verify "$browser" eval "!new URL(location.href).searchParams.get('evidence') ? 'evidence closed' : (()=>{throw new Error('evidence URL remained active')})()" || fail "evidence URL remained active before context test"
  step inspector-open-without-evidence "$browser" click '.run-inspector-open' || fail "run inspector could not be opened without evidence"
  step inspector-close-without-evidence "$browser" eval "document.querySelector('.inspector-close')?.click(); 'closed'" || fail "run inspector could not be closed without evidence"
  step inspector-close-without-evidence-settle "$browser" wait 100 || fail "run inspector close without evidence did not settle"
  step inspector-restores-summary "$browser" eval "(()=>{const summary=document.querySelector('[data-ui-id=\"context-summary\"]'); if(summary.hidden) throw new Error('context summary remained hidden'); return 'context summary restored'})()" || fail "inspector close did not restore source summary"
  record inspector-context-restoration pass "evidence and source summary restored after inspector close"
else
  record inspector-context-restoration skipped "set DSW_BROWSER_EXPECT_MAINTAINER=1 with an administrator browser fixture"
fi

step return-to-chat "$browser" back || fail "could not go back in chat history"
step return-wait "$browser" wait '[data-ui-id="message-timeline"]' || fail "chat timeline did not remain available"
race_first="S1"
race_second="S2"
if [[ "$(count '[data-evidence-marker="S2"]')" -gt 0 ]]; then
  race_code="window.__dswRaceOriginalFetch=window.fetch; window.fetch=(url,opts={})=>String(url).includes('/evidence/${race_first}/')?new Promise(resolve=>setTimeout(()=>window.__dswRaceOriginalFetch(url,{...opts,signal:undefined}).then(resolve),900)):window.__dswRaceOriginalFetch(url,opts); 'race wrapper installed'"
  step race-install "$browser" eval "$race_code" || fail "race wrapper could not be installed"
  step race-first "$browser" eval "document.querySelector('[data-evidence-marker=\"$race_first\"]')?.click(); 'first requested'" || fail "slow evidence could not be selected"
  "$browser" wait 100 >/dev/null 2>&1 || true
  step race-second "$browser" eval "document.querySelector('[data-evidence-marker=\"$race_second\"]')?.click(); 'second requested'" || fail "fast evidence could not be selected"
  step race-fast-wait "$browser" wait 300 || fail "fast evidence wait failed"
  step race-before-release "$browser" screenshot "$output_dir/race-before-release.png" || fail "race pre-release screenshot failed"
  step race-release-wait "$browser" wait 1100 || fail "delayed response wait failed"
  step race-after-release "$browser" eval "new URL(location.href).searchParams.get('evidence')==='${race_second}' ? 'late response ignored' : (()=>{throw new Error('stale evidence won')})()" || fail "stale response replaced current selection"
  step race-after-release-screenshot "$browser" screenshot "$output_dir/race-after-release.png" || fail "race post-release screenshot failed"
  record delayed-response-race pass "late ${race_first} response delivered after ${race_second} and remained ignored"
else
  record delayed-response-race fail "fixture needs at least two citations"
fi

step history-reset-close "$browser" press Escape || fail "could not close evidence with Escape"
step history-reset-close-verify "$browser" eval "!new URL(location.href).searchParams.get('evidence') ? 'history reset' : (()=>{throw new Error('close did not update URL')})()" || fail "close control did not update evidence history"
step history-open-first "$browser" eval "document.querySelector('[data-evidence-marker=\"$race_first\"]')?.click(); 'first'" || fail "history first selection failed"
step history-open-second "$browser" eval "document.querySelector('[data-evidence-marker=\"$race_second\"]')?.click(); 'second'" || fail "history second selection failed"
step history-back-first "$browser" back || fail "history back failed"
step history-verify-first "$browser" eval "new URL(location.href).searchParams.get('evidence')==='${race_first}' ? 'first restored' : (()=>{throw new Error('first not restored')})()" || fail "history did not restore first evidence"
step history-back-closed "$browser" back || fail "history second back failed"
step history-verify-closed "$browser" eval "!new URL(location.href).searchParams.get('evidence') ? 'closed restored' : (()=>{throw new Error('reader not closed')})()" || fail "history did not close evidence"
step history-forward-first "$browser" forward || fail "history forward first failed"
step history-forward-verify-first "$browser" eval "new URL(location.href).searchParams.get('evidence')==='${race_first}' ? 'first forward' : (()=>{throw new Error('first forward failed')})()" || fail "history forward did not restore first"
step history-forward-second "$browser" forward || fail "history forward second failed"
step history-forward-verify-second "$browser" eval "new URL(location.href).searchParams.get('evidence')==='${race_second}' ? 'second forward' : (()=>{throw new Error('second forward failed')})()" || fail "history forward did not restore second"
step draft-preservation "$browser" eval "const t=document.querySelector('[data-ui-id=\"composer\"] textarea'); t.value='draft survives evidence navigation'; t.dispatchEvent(new Event('input',{bubbles:true})); document.querySelector('[data-evidence-marker=\"${race_first}\"]')?.click(); 'draft set'" || fail "draft preservation setup failed"
step draft-verify "$browser" eval "document.querySelector('[data-ui-id=\"composer\"] textarea')?.value==='draft survives evidence navigation' ? 'draft preserved' : (()=>{throw new Error('draft lost')})()" || fail "draft was lost"

for viewport in 1440x1000 1024x768 390x844; do
  width="${viewport%x*}"; height="${viewport#*x}"
  step "viewport-${viewport}" "$browser" set viewport "$width" "$height" || fail "could not set viewport $viewport"
  step "viewport-${viewport}-open" "$browser" eval "document.querySelector('[data-evidence-marker=\"${race_first}\"]')?.click(); 'opened'" || fail "could not open evidence at $viewport"
  step "viewport-${viewport}-wait" "$browser" wait 500 || fail "evidence did not settle at $viewport"
  step "viewport-${viewport}-assert" "$browser" eval "(()=>{const d=document.documentElement; const panel=document.querySelector('[data-ui-id=\"evidence-reader\"]'); const close=document.querySelector('.evidence-close'); const composer=document.querySelector('[data-ui-id=\"composer\"]'); const scrollables=[...document.querySelectorAll('.chat-sessions,.chat-messages,.chat-context,.evidence-page-viewport')].filter(x=>!x.closest('[hidden]')); if(d.scrollWidth>d.clientWidth+2) throw new Error('body overflow'); if(!panel||!close||!composer||scrollables.some(x=>x.clientHeight<1)) throw new Error('workspace control/scroll failure'); return JSON.stringify({viewport:'$viewport',bodyScrollWidth:d.scrollWidth,bodyClientWidth:d.clientWidth,focus:document.activeElement?.dataset?.uiId||document.activeElement?.id||null,selected:new URL(location.href).searchParams.get('evidence'),scrollables:scrollables.map(x=>({id:x.dataset.uiId||x.className,height:x.clientHeight}))})})()" || fail "responsive assertions failed at $viewport"
  step "viewport-${viewport}-screenshot" "$browser" screenshot "$output_dir/chat-${viewport}.png" || fail "viewport screenshot failed at $viewport"
done

snapshot returned-chat
step return-screenshot "$browser" screenshot "$output_dir/returned-chat.png" || fail "return screenshot failed"
record return-to-chat pass
