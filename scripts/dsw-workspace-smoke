#!/usr/bin/env bash
set -uo pipefail

# Document workspace regression smoke. Verifies the core rework invariant:
# once a page image is loaded, region-level work (selection, transcription
# save, recognition run and its completion + 'Use transcription' accept) must
# NEVER recreate the OpenSeadragon viewer or reload the page. Asserts via
# window.__DSW_WORKSPACE__.viewer.stats():
#   generation/imageLoads must not change during region work,
#   selectionChanges/focusChanges must advance.
# The recognition step also waits for the run to COMPLETE across >=2 rail
# replacements and applies the accepted HTR/Vision candidate, which is the
# regression that only appears once the disposable version rail is replaced
# several times (the 'Use transcription' handler must survive rail swaps).
# The server must run with DSW_HTR_FIXTURE_MODE=true and an OCR worker active
# so the fixture recognition run actually completes.
#
# Credentials and targets come from the environment only (never the result).
base_url="${DSW_BROWSER_BASE_URL:-http://127.0.0.1:8000}"
username="${DSW_BROWSER_USERNAME:-}"
password="${DSW_BROWSER_PASSWORD:-}"
source_id="${DSW_WS_SOURCE_ID:-1}"
revision_id="${DSW_WS_REVISION_ID:-1}"
page_number="${DSW_WS_PAGE:-1}"
region_a="${DSW_WS_REGION_A:-2}"
region_b="${DSW_WS_REGION_B:-3}"
region_c="${DSW_WS_REGION_C:-1}"
output_dir="${DSW_BROWSER_OUTPUT_DIR:-/tmp/dsw-workspace-smoke-$(date +%Y%m%d-%H%M%S)}"
allow_remote="${DSW_BROWSER_ALLOW_REMOTE:-0}"
browser="$(dirname "$0")/agent-browser-dsw"
session="dsw-workspace-smoke-$(date +%s)"

usage() {
  cat <<'EOF'
Usage: scripts/dsw-workspace-smoke [options]

Runs the document workspace regression acceptance flow: log in, open a deep
link, then assert that selecting a region, saving a transcription and running
a recognition job never recreate the viewer (imageLoads must stay constant)
while the selection count advances and the URL stays deep-linkable.

Options:
  -h, --help          Show this help.
  --base-url URL      Application URL (or DSW_BROWSER_BASE_URL).
  --username NAME     Browser test username (or DSW_BROWSER_USERNAME).
  --password PASSWORD Convenience only; prefer DSW_BROWSER_PASSWORD.
  --source-id ID      Fixture source document id (default 1).
  --revision-id ID    Immutable revision id (default 1).
  --page N            Page number to open (default 1).
  --region-a ID       A region on the page to select first.
  --region-b ID       A second region to select (default 3).
  --output-dir PATH   Artifact directory.
  --allow-remote      Permit non-local BASE_URL (required for staging).

Requires a running server with an OpenSeadragon-served page image and at least
two detected regions, plus a fixture user who can edit the document.
EOF
}
while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0;;
    --base-url) base_url="${2:?missing URL}"; shift 2;;
    --username) username="${2:?missing username}"; shift 2;;
    --password) password="${2:?missing password}"; shift 2;;
    --source-id) source_id="${2:?missing source id}"; shift 2;;
    --revision-id) revision_id="${2:?missing revision id}"; shift 2;;
    --page) page_number="${2:?missing page}"; shift 2;;
    --region-a) region_a="${2:?missing region a}"; shift 2;;
    --region-b) region_b="${2:?missing region b}"; shift 2;;
    --region-c) region_c="${2:?missing region c}"; shift 2;;
    --output-dir) output_dir="${2:?missing output directory}"; shift 2;;
    --allow-remote) allow_remote=1; shift;;
    *) echo "workspace-smoke: unknown option $1" >&2; usage >&2; exit 2;;
  esac
done

case "$base_url" in
  http://127.0.0.1:*|http://localhost:*|https://127.0.0.1:*|https://localhost:*) ;;
  *) [[ "$allow_remote" == 1 ]] || { echo "workspace-smoke: remote URL requires --allow-remote" >&2; exit 2; };;
esac
mkdir -p "$output_dir"
steps_file="$output_dir/steps.ndjson"
: > "$steps_file"

record() { python3 -c 'import json,sys; print(json.dumps({"scenario":sys.argv[1],"status":sys.argv[2],"detail":sys.argv[3]}))' "$1" "$2" "$3" >> "$steps_file"; }
fail() { echo "workspace-smoke: $*" >&2; exit 1; }

# Run an eval that is expected to print a non-empty JSON on success (throws otherwise).
step_assert() { # $1 name, $2 js
  local out
  out="$("$browser" --session "$session" eval "$2" 2>/dev/null)"
  if [[ -n "$out" && "$out" != *"threw"* && "$out" != "null" ]]; then
    record "$1" pass "$out"; return 0
  fi
  record "$1" fail "$2"; return 1
}

# Best-effort fixture hygiene: revert the currently-active correction on the
# selected region by re-fetching the inspector and POSTing its Revert action
# (a rail-only save does not re-render the Revert button into the DOM itself).
# Kept as one short single-line eval; each call revokes one active correction.
cleanup_fixture() {
  "$browser" --session "$session" eval '(async()=>{const ws=window.__DSW_WORKSPACE__;const rid=ws.state.regionId;const pane=document.getElementById("inspector-pane-region");try{const resp=await fetch("/regions/"+rid+"/inspector/",{credentials:"same-origin",headers:{Accept:"text/html","HX-Request":"true"}});if(resp.ok)pane.innerHTML=await resp.text();}catch(e){}if(window.htmx)window.htmx.process(pane);const btn=document.querySelector("[data-transcription-action=revert]");if(!btn)return "no-revert-btn";const url=btn.getAttribute("hx-post");let csrf="";const meta=document.querySelector("meta[name=csrf-token]");if(meta)csrf=meta.content;const hid=document.querySelector("[name=csrfmiddlewaretoken]");if(!csrf&&hid)csrf=hid.value;const r=await fetch(url,{method:"POST",credentials:"same-origin",headers:{"X-CSRFToken":csrf,"HX-Request":"true"}});return "revert "+r.status+" "+url;})()' >/dev/null 2>&1
  sleep 1
}

finish() {
  local status=$?
  "$browser" --session "$session" console >"$output_dir/console.log" 2>&1 || true
  "$browser" --session "$session" errors >"$output_dir/errors.log" 2>&1 || true
  "$browser" close --all >/dev/null 2>&1 || true
  return "$status"
}
trap finish EXIT

[[ -n "$username" && -n "$password" ]] || fail "set DSW_BROWSER_USERNAME and DSW_BROWSER_PASSWORD"

# ---- Login ----
"$browser" --session "$session" close --all >/dev/null 2>&1 || true
"$browser" --session "$session" open "$base_url/login/" >/dev/null 2>&1 || fail "login page did not open"
sleep 1.5
"$browser" --session "$session" find label Username fill "$username" >/dev/null 2>&1 || fail "username field not found"
sleep 0.3
"$browser" --session "$session" find label Password fill "$password" >/dev/null 2>&1 || fail "password field not found"
sleep 0.3
"$browser" --session "$session" find role button click --name Login >/dev/null 2>&1 || fail "login submit failed"
sleep 1.5

# ---- Open a deep link; wait for the viewer ----
url="$base_url/documents/$source_id/?revision=$revision_id&page=$page_number&region=$region_a&test_drawn=1"
"$browser" --session "$session" open "$url" >/dev/null 2>&1 || fail "workspace deep link did not open"
# This harness runs headless where OSD tile-drawn may never fire, so it opts
# into the test-only draw fallback (tile-loaded proxies drawing) and then waits
# for real imagery to be signalled — status leaves 'loading'. Production never
# reveals overlays on tile-loaded; only this test hook does.
for _ in $(seq 1 40); do
  if "$browser" --session "$session" eval 'window.__DSW_WORKSPACE__ && (window.__DSW_WORKSPACE__.viewer.setTestDrawnFallback(true), window.__DSW_WORKSPACE__.viewer.status()!=="loading") ? "yes":"no"' 2>/dev/null | grep -q yes; then break; fi
  sleep 0.5
done
step_assert deep-link-restored "(()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const s=ws.viewer.stats();if((s.imageLoads!==1)||ws.state.regionId!=='$region_a')throw new Error('deep link state');return JSON.stringify({imageLoads:s.imageLoads,regionId:ws.state.regionId});})()" || fail "deep link did not restore + open viewer"

# ---- Truthful loading state: a page WITH an image is never 'empty'. ----
step_assert loading-state-never-empty "(()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');if(ws.viewer.status()==='empty')throw new Error('page with image reported empty');if(!ws.state.imageLevels||ws.state.imageLevels.length<2)throw new Error('expected image pyramid levels');return JSON.stringify({status:ws.viewer.status(),nLevels:ws.state.imageLevels.length,imageLoads:ws.viewer.stats().imageLoads});})()" || fail "loading/empty state is not truthful"

# ---- Page rail must use the lightweight thumbnail derivative, not the full scan. ----
step_assert thumbnail-derivative "(()=>{const img=document.querySelector('.page-list-item img');if(!img)throw new Error('no rail thumbnail');if(!img.currentSrc.includes('/derivative/thumbnail/'))throw new Error('rail uses full image, not thumbnail: '+img.currentSrc);return JSON.stringify({src:img.currentSrc});})()" || fail "page rail is not using thumbnail derivatives"

# ---- Deterministic focus: same region from different prior states → same bounds. ----
step_assert focus-deterministic "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const vp=ws.viewer.viewer.viewport;const bounds=()=>{const b=vp.getBounds(false);return [+b.x.toFixed(5),+b.y.toFixed(5),+b.width.toFixed(5),+b.height.toFixed(5)];};const sorted=[...ws.state.regions].sort((a,b)=>(a.bbox.width*a.bbox.height)-(b.bbox.width*b.bbox.height));const small=sorted[0].id,large=sorted[sorted.length-1].id;ws.viewer.fitPage();await new Promise(r=>setTimeout(r,250));await ws.selectRegion(small,{focus:true});await new Promise(r=>setTimeout(r,250));const b1=bounds();vp.zoomTo(vp.getZoom()*0.2,vp.getCenter(),true);vp.panBy(new OpenSeadragon.Point(2,2));await new Promise(r=>setTimeout(r,250));await ws.selectRegion(large,{focus:true});await new Promise(r=>setTimeout(r,250));await ws.selectRegion(small,{focus:true});await new Promise(r=>setTimeout(r,250));const b2=bounds();const tol=0.01;const same=Math.abs(b1[0]-b2[0])<tol&&Math.abs(b1[1]-b2[1])<tol&&Math.abs(b1[2]-b2[2])<tol&&Math.abs(b1[3]-b2[3])<tol;if(!same)throw new Error('focus not deterministic');return JSON.stringify({small,large,same,b1,b2});})()" || fail "focus determinism failed"

# ---- Selected region fully visible (no crop). ----
step_assert selected-region-visible "(()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)return null;const reg=ws.state.regions.find(r=>String(r.id)===String(ws.state.regionId));if(!reg)return null;const vp=ws.viewer.viewer.viewport;const vb=vp.getBounds(true);const img=ws.viewer.viewer.world.getItemAt(0).getBounds();const rx=img.x+reg.bbox.left*img.width,ry=img.y+reg.bbox.top*img.height,rw=reg.bbox.width*img.width,rh=reg.bbox.height*img.height;const ok=[[rx,ry],[rx+rw,ry],[rx,ry+rh],[rx+rw,ry+rh]].every(([x,y])=>x>=vb.x-0.5&&x<=vb.x+vb.width+0.5&&y>=vb.y-0.5&&y<=vb.y+vb.height+0.5);if(!ok)throw new Error('selected region cropped');return JSON.stringify({visible:true});})()" || fail "selected region not fully visible"

# ---- Overlay/geometry alignment: the on-screen overlay box must match the
#      adapter's viewport rect at fit-page, after zoom, after pan, and after
#      fit-width. This is the deploy blocker for region/image coordinate fidelity.
step_assert overlay-alignment "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');await ws.selectRegion('$region_b',{focus:false});await new Promise(r=>setTimeout(r,300));const host=document.getElementById('viewer-host');const el=document.querySelector('.region-overlay[data-region-id=\"$region_b\"]');if(!el)throw new Error('no overlay for region');const mismatch=()=>{const d=ws.viewer.diagnostics();const sexp=(d.selectedRegion&&d.selectedRegion.viewport);if(!sexp)throw new Error('no selected viewport');const elRect=ws.viewer.viewer.viewport.viewportToViewerElementRectangle(new OpenSeadragon.Rect(sexp.x,sexp.y,sexp.width,sexp.height));const hrect=host.getBoundingClientRect();const box=el.getBoundingClientRect();const dx=Math.abs((box.x-hrect.x)-elRect.x);const dy=Math.abs((box.y-hrect.y)-elRect.y);const dw=Math.abs(box.width-elRect.width);const dh=Math.abs(box.height-elRect.height);return {dx,dy,dw,dh};};const tol=3;const states=[];const apply=async(name,fn)=>{await fn();await new Promise(r=>setTimeout(r,300));const m=mismatch();if(m.dx>tol||m.dy>tol||m.dw>tol||m.dh>tol)throw new Error('overlay drift at '+name+' '+JSON.stringify(m));states.push(name+':'+JSON.stringify(m));};
await apply('fit-page',()=>ws.viewer.fitPage());
await apply('zoom-in',()=>ws.viewer.zoomBy(2.2));
await apply('pan',()=>ws.viewer.viewer.viewport.panBy(new OpenSeadragon.Point(0.2,0.1),true));
await apply('fit-width',()=>ws.viewer.fitWidth());
return JSON.stringify({states});})()" || fail "overlay/image alignment drifted across zoom/pan/fit-width"

# ---- Focus uses exactly the adapter/overlay rectangle (the region rect is
#      contained in, and derived from, the same geometry as the overlay). ----
step_assert focus-uses-overlay-rect "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');await ws.selectRegion('$region_b',{focus:true});await new Promise(r=>setTimeout(r,400));const d=ws.viewer.diagnostics();const r=d.selectedRegion.viewport;const vb=d.viewportBounds;const inside=r.x>=vb.x-0.01&&r.y>=vb.y-0.01&&(r.x+r.width)<=vb.x+vb.width+0.01&&(r.y+r.height)<=vb.y+vb.height+0.01;if(!d.selectedRegion)throw new Error('no selected region');if(!inside)throw new Error('focused region not fully within viewport');return JSON.stringify({inside,viewport:d.viewportBounds,region:r});})()" || fail "focus does not use the exact overlay rectangle"

# ---- Selected-ID consistency across workspace/viewer/overlay/focus-button. ----
step_assert selected-id-consistent "(()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const st=ws.state.regionId;if(!st)throw new Error('no selection');const selEl=document.querySelector('.region-overlay.is-selected');if(!selEl||selEl.dataset.regionId!==String(st))throw new Error('overlay selection mismatch: '+st);if(String(ws.viewer.activeSelectedId())!==String(st))throw new Error('viewer internal selection mismatch');const fb=document.querySelector(\"[data-viewer-action='focus-region']\");if(!fb||fb.disabled)throw new Error('focus button not enabled');return JSON.stringify({regionId:st,overlay:selEl.dataset.regionId,viewer:ws.viewer.activeSelectedId()});})()" || fail "workspace/viewer/overlay selected id diverged"

# ---- Stale async guard: rapid A → B → C must end on C (no stale overwrite). ----
step_assert rapid-select-stale-guard "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const before=ws.viewer.stats();await Promise.all([ws.selectRegion('$region_a',{push:false}),ws.selectRegion('$region_b',{push:false}),ws.selectRegion('$region_c',{push:false})]);await new Promise(r=>setTimeout(r,600));if(ws.state.regionId!=='$region_c')throw new Error('stale region won: '+ws.state.regionId);const pane=document.getElementById('inspector-pane-region');if(pane.dataset.regionId!=='$region_c')throw new Error('inspector stale: '+pane.dataset.regionId);if(String(ws.viewer.activeSelectedId())!=='$region_c')throw new Error('viewer selection stale');const after=ws.viewer.stats();if(after.imageLoads!==before.imageLoads)throw new Error('viewer reloaded');return JSON.stringify({regionId:ws.state.regionId,pane:pane.dataset.regionId});})()" || fail "stale async region responses overwrote current state"

# ---- Wheel/trackpad: plain wheel pans (zoom unchanged); Ctrl+wheel zooms. ----
step_assert wheel-pan-and-ctrl-zoom "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const vp=ws.viewer.viewer.viewport;ws.viewer.fitPage();await new Promise(r=>setTimeout(r,250));const z0=vp.getZoom();const b0={x:vp.getBounds(false).x,y:vp.getBounds(false).y};const host=document.getElementById('viewer-host');host.dispatchEvent(new WheelEvent('wheel',{deltaY:120,deltaX:0,bubbles:true,cancelable:true,clientX:host.clientWidth/2,clientY:host.clientHeight/2}));await new Promise(r=>setTimeout(r,200));const z1=vp.getZoom();if(Math.abs(z1-z0)>1e-6)throw new Error('plain wheel changed zoom');const moved=Math.abs(vp.getBounds(false).x-b0.x)>1e-6||Math.abs(vp.getBounds(false).y-b0.y)>1e-6;if(!moved)throw new Error('plain wheel did not pan');host.dispatchEvent(new WheelEvent('wheel',{deltaY:-120,ctrlKey:true,bubbles:true,cancelable:true,clientX:host.clientWidth/2,clientY:host.clientHeight/2}));await new Promise(r=>setTimeout(r,250));const z2=vp.getZoom();if(!(z2>z1))throw new Error('ctrl+wheel did not zoom in');return JSON.stringify({z0,z1,z2,panned:moved});})()" || fail "wheel pan/zoom behaviour is wrong"

# ---- Resize sync: after changing container geometry, overlays stay aligned. ----
step_assert resize-alignment "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');await ws.selectRegion('$region_b',{focus:false});await new Promise(r=>setTimeout(r,300));const before=ws.viewer.stats();const host=document.getElementById('viewer-host');const el=document.querySelector('.region-overlay[data-region-id=\"$region_b\"]');const insp=document.getElementById('region-inspector');const orig=insp.style.width;insp.style.width='560px';ws.viewer.resyncGeometry();await new Promise(r=>setTimeout(r,300));const d=ws.viewer.diagnostics();const sexp=d.selectedRegion.viewport;const elRect=ws.viewer.viewer.viewport.viewportToViewerElementRectangle(new OpenSeadragon.Rect(sexp.x,sexp.y,sexp.width,sexp.height));const hrect=host.getBoundingClientRect();const box=el.getBoundingClientRect();const dx=Math.abs((box.x-hrect.x)-elRect.x),dy=Math.abs((box.y-hrect.y)-elRect.y);insp.style.width=orig;ws.viewer.resyncGeometry();await new Promise(r=>setTimeout(r,250));if(dx>3||dy>3)throw new Error('overlay drifted after resize: '+dx+','+dy);if(ws.viewer.stats().imageLoads!==before.imageLoads)throw new Error('resize reloaded image');return JSON.stringify({dx,dy,imageLoads:ws.viewer.stats().imageLoads});})()" || fail "container resize shifted overlays or reloaded the image"

# ---- Select another region (same code path a canvas-click invokes). ----
step_assert region-select-no-reload "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const before=ws.viewer.stats();await ws.selectRegion('$region_b',{focus:true});await new Promise(r=>setTimeout(r,500));const after=ws.viewer.stats();if(after.imageLoads!==before.imageLoads)throw new Error('viewer reloaded');if(ws.state.regionId!=='$region_b')throw new Error('region not selected');return JSON.stringify({imageLoads:after.imageLoads,selectionChanges:after.selectionChanges,regionId:ws.state.regionId});})()" || fail "region selection recreated the viewer or did not select"

# ---- Save a transcription edit; viewer must not reload. ----
"$browser" --session "$session" eval "(()=>{const a=document.querySelector('#transcription-area');if(!a)throw new Error('no textarea');a.value=a.value+' [ws-smoke]';a.dispatchEvent(new Event('input',{bubbles:true}));return 'edited';})()" >/dev/null 2>&1
"$browser" --session "$session" eval "document.querySelector('[data-transcription-action=save]')?.click();'save'" >/dev/null 2>&1
sleep 0.8
step_assert manual-save-no-reload "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const after=ws.viewer.stats();if(after.imageLoads!==1)throw new Error('viewer reloaded');const a=document.querySelector('#transcription-area');if(!a)throw new Error('no textarea');if(a.value!==a.dataset.expectedCurrent)throw new Error('save not persisted');return JSON.stringify({imageLoads:after.imageLoads,persisted:a.value.slice(0,30)});})()" || fail "manual save recreated the viewer or did not persist"

# ---- Hygiene: revert the correction created by the manual save above so the
#      smoke does not silently mutate shared/staging document content. The server
#      should run with DSW_HTR_FIXTURE_MODE=true so recognition is simulated.
#      A rail-only save does not re-render the editor, so we re-fetch the region
#      inspector (making the Revert button reflect the new active correction),
#      then POST Revert to restore the prior effective text.
cleanup_fixture
sleep 0.5
echo "workspace-smoke: cleaned previous manual-save correction (revert POSTed)"

# ---- Run a recognition job (Vision when configured, else HTR); version rail becomes
#      pending without recreating anything. Server should use fixture mode so no real
#      provider work is incurred.
step_assert run-vision-no-reload "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!ws)throw new Error('no workspace');const before=ws.viewer.stats();const btn=document.querySelector('.split-button[data-split-button=vision] .split-button-main')||document.querySelector('.split-button[data-split-button=htr] .split-button-main');if(!btn)throw new Error('no recognition button');btn.click();let pending=false;for(let i=0;i<20;i++){await new Promise(r=>setTimeout(r,300));const v=document.querySelector('#inspector-versions');if(v&&v.dataset.pending==='true'){pending=true;break;}}const after=ws.viewer.stats();if(after.imageLoads!==before.imageLoads)throw new Error('viewer reloaded');if(!document.querySelector('#inspector-editor'))throw new Error('editor lost');if(!pending)throw new Error('rail did not become pending');return JSON.stringify({imageLoads:after.imageLoads,selectionChanges:after.selectionChanges,pending:true});})()" || fail "recognition run recreated the viewer or did not update the rail"

record finish pass "imageLoads stayed constant through selection, save and vision run"

# ---- Recognition completes across >=2 rail replacements, then 'Use
#      transcription' must persist the accepted candidate through event
#      delegation on the persistent region pane (the accept button physically
#      lives inside the disposable rail, so a listener wired only to a rail
#      button would be lost). Each browser eval stays SHORT (well under the CDP
#      eval timeout); waiting is driven from bash. ----
# Capture the editor text before we accept, so we can prove it actually changed.
tb="$("$browser" --session "$session" eval '(document.querySelector("#transcription-area")||{}).value||""' 2>/dev/null)"
# Install a rail-replacement counter BEFORE polling finishes so we can prove the
# accept survived at least a couple of rail swaps (the class of bug being
# regressed); repeated innerHTML swaps of #inspector-versions are counted.
"$browser" --session "$session" eval 'window.__RAIL_REPLACES__=0;try{const pm=document.getElementById("inspector-pane-region");if(pm&&!pm.__wsmo){pm.__wsmo=new MutationObserver(muts=>{for(const m of muts){if(m.addedNodes.length&&[...m.addedNodes].some(n=>n&&n.id==="inspector-versions"))window.__RAIL_REPLACES__=(window.__RAIL_REPLACES__||0)+1;}});pm.__wsmo.observe(pm,{childList:true,subtree:true});}}catch(e){}ok' >/dev/null 2>&1
# Wait for the run to complete and a selectable HTR/Vision candidate to appear.
step_pending=1
max_repl=0
for _ in $(seq 1 60); do
  out="$("$browser" --session "$session" eval '(async()=>{const v=document.querySelector("#inspector-versions");if(!v)return JSON.stringify({p:"",cand:false,repl:(window.__RAIL_REPLACES__||0)});const cand=[...v.querySelectorAll(".version-item.kind-htr,.version-item.kind-vision")].some(it=>!it.classList.contains("is-pending")&&!((it.querySelector("[data-version-select]")||{}).disabled));return JSON.stringify({p:v.dataset.pending,cand:!!cand,repl:(window.__RAIL_REPLACES__||0)});})()' 2>/dev/null)"
  # The browser CLI returns the eval result double-JSON-encoded; decode it here.
  set -- $(printf '%s' "$out" | python3 -c 'import json,sys
line=sys.stdin.read().strip()
try:
  d=json.loads(json.loads(line) if line.startswith("\"") else line)
  p=d.get("p",""); c=d.get("cand",""); r=d.get("repl",0)
  print(p, str(c).lower(), r)
except Exception:
  print("","","")')
  pk="$1"; ck="$2"; repl="$3"
  [ -n "$repl" ] && [ "$repl" -gt "$max_repl" ] 2>/dev/null && max_repl=$repl
  if [ "$pk" = "false" ] && [ "$ck" = "true" ]; then step_pending=0; break; fi
  sleep 1
done
if [ "$step_pending" = "1" ]; then fail "recognition never completed within timeout"; fi
if [ "$max_repl" -lt 2 ]; then fail "expected >=2 rail replacements, got $max_repl"; fi
# Select the HTR/Vision candidate (starts the comparison) then click Use transcription.
"$browser" --session "$session" eval '(async()=>{const kind=document.querySelector(".split-button[data-split-button=vision]")?"vision":"htr";const v=document.querySelector("#inspector-versions");const cand=[...v.querySelectorAll(".version-item.kind-"+kind+",.version-item.kind-vision,.version-item.kind-htr")].find(it=>!it.classList.contains("is-pending"));cand.querySelector("[data-version-select]").click();return "sel";})()' >/dev/null 2>&1
"$browser" --session "$session" eval 'const a=document.querySelector("#version-compare-accept");if(!a||a.hidden||!a.dataset.acceptUrl)throw new Error("no accept url");a.click();"clicked"' >/dev/null 2>&1 || fail "Use transcription not offered / no accept url"
# Wait for the effective textarea to change away from the pre-accept value.
step_applied=1
for _ in $(seq 1 40); do
  now="$("$browser" --session "$session" eval '(document.querySelector("#transcription-area")||{}).value||""' 2>/dev/null)"
  if [ -n "$now" ] && [ "$now" != "$tb" ]; then step_applied=0; break; fi
  sleep 0.5
done
if [ "$step_applied" = "1" ]; then fail "Use transcription did not change the effective textarea"; fi
# Assert Current became HTR/Vision, the editor survives, and the viewer did not reload.
step_assert recognition-completes-use-transcription "(async()=>{const ws=window.__DSW_WORKSPACE__;if(!document.querySelector('#inspector-editor'))throw new Error('editor lost after accept');const src=(document.querySelector('.version-current-source')?.textContent||'').toLowerCase();if(src.indexOf('vision')===-1&&src.indexOf('htr')===-1&&src.indexOf('kurrent')===-1)throw new Error('Current did not become HTR/Vision: '+src);const s=ws.viewer.stats();return JSON.stringify({currentSource:src,imageLoads:s.imageLoads,repl:$max_repl});})()" || fail "recognition completion / Use transcription acceptance failed"

# Hygiene: best-effort revert of the correction accepted above so repeated runs do
# not accumulate active corrections on the shared fixture.
cleanup_fixture
sleep 0.5
echo "workspace-smoke: cleaned recognition-accepted correction (revert POSTed)"

record finish pass "recognition completes and 'Use transcription' persists (regression for delegated accept)"
"$browser" --session "$session" screenshot "$output_dir/final.png" >/dev/null 2>&1 || true
echo "workspace-smoke: PASS — imageLoads stayed constant through all region-level actions"
